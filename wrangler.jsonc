{
	// ReadCipe: deck + Read & Check pages (dist/site) + /api/* in one Worker.
	// The name must stay "wispy-fog-b991" so the existing workers.dev URL keeps working.
	"name": "wispy-fog-b991",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-05-01",
	"assets": {
		"directory": "./dist/site",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		// Scores (worker/schema.sql). Local `wrangler dev` uses a local copy, so tests never touch class data.
		{
			"binding": "DB",
			"database_name": "readcipe",
			"database_id": "465850e9-daf4-41ae-b012-b354ba3f6012"
		}
	],
	// Per-IP limits; the code skips them if the binding is missing.
	"ratelimits": [
		{
			"name": "TOKEN_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "SCORE_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
	// Secrets (never in this file): npx wrangler secret put AZURE_SPEECH_KEY / AZURE_SPEECH_REGION
	// Local dev: put them in .dev.vars (git-ignored).
}